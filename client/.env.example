# ─── AquaLoop Client — Environment Variables ─────────────────
# Copy this file to .env.local and fill in values.
# Vite exposes only vars prefixed with VITE_ to the browser.
# NEVER put secrets here — these values are visible in the browser bundle.

# API base URL (only needed if not using the Vite proxy in vite.config.js)
# VITE_API_BASE_URL=http://localhost:5000
