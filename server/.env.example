# ─── AquaLoop Server — Environment Variables ──────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env to Git.

# ── Server ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed CORS origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173

# ── Database (Phase 2) ────────────────────────────────────────
# MongoDB Atlas M0 connection string
# Get from: https://cloud.mongodb.com → Connect → Drivers
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/aqualoop?retryWrites=true&w=majority

# ── Authentication (Phase 2) ──────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# JWT_SECRET=<64-character-random-hex-string>
# JWT_EXPIRES_IN=7d
# COOKIE_SECRET=<another-64-character-random-hex-string>

# ── Cloudinary (Phase 4 — free tier, account required) ────────
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── Email (Phase 4 — Gmail SMTP, free, 500/day) ───────────────
# EMAIL_FROM=noreply@example.com
# GMAIL_USER=your-gmail@gmail.com
# GMAIL_APP_PASSWORD=<google-app-password-not-your-login-password>
