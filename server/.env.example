# ─── AquaLoop Server — Environment Variables ──────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env to Git.

# ── Server ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed CORS origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173

# ── Database (Phase 2) ────────────────────────────────────────
# Option A: Local MongoDB Community Server (Recommended for ₹0 local development)
# Download from: https://www.mongodb.com/try/download/community
MONGODB_URI=mongodb://localhost:27017/aqualoop

# Option B: MongoDB Atlas M0 (Free cloud tier, 512MB)
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/aqualoop?retryWrites=true&w=majority

# ── Authentication (Phase 2) ──────────────────────────────────
# Generate 64-char secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=aqualoop-dev-secret-change-in-production-min-32-chars!
JWT_EXPIRES_IN=7d
COOKIE_SECRET=aqualoop-cookie-secret-change-in-production-min-32-chars!

# ── Cloudinary (Phase 4 — free tier, account required) ────────
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── Email (Phase 4 — Gmail SMTP, free, 500/day) ───────────────
# EMAIL_FROM=noreply@example.com
# GMAIL_USER=your-gmail@gmail.com
# GMAIL_APP_PASSWORD=<google-app-password-not-your-login-password>
